{
  "name": "kan",
  "private": true,
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9.14.2"
  },
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "cron:materialize": "pnpm exec dotenv -e .env -- pnpm exec tsx packages/db/src/scripts/materialize-task-instances.ts",
    "cron:missed": "pnpm exec dotenv -e .env -- pnpm exec tsx packages/db/src/scripts/update-missed-task-instances.ts",
    "task-instance:backfill-actual-date": "pnpm exec dotenv -e .env -- pnpm exec tsx packages/db/src/scripts/backfill-task-instance-actual-dates.ts",
    "cron:scheduler": "pnpm exec dotenv -e .env -- pnpm exec tsx packages/db/src/scripts/task-instance-scheduler.ts",
    "db:generate": "cd packages/db && pnpm generate",
    "db:migrate": "cd packages/db && pnpm migrate",
    "db:push": "turbo -F @kan/db push",
    "db:studio": "turbo -F @kan/db studio",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @kan/web...",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add"
  },
  "devDependencies": {
    "@kan/prettier-config": "workspace:*",
    "@turbo/gen": "^2.3.1",
    "prettier": "catalog:",
    "turbo": "^2.3.1",
    "typescript": "catalog:"
  },
  "prettier": "@kan/prettier-config",
  "pnpm": {
    "overrides": {
      "@types/minimatch": "npm:minimatch@*",
      "@types/glob": "npm:@types/glob@^8.1.0"
    }
  }
}
